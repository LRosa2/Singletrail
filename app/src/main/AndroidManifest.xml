<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location only while riding, in the foreground (spec S5): no background location. Coarse is
         requested with fine, as Android 12+ requires; the app needs fine to guide. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for downloads the user starts: a GPX link (spec §8.4, S4) and, later, map files (S6). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!--
        Backup policy (spec D21 / S1): no cloud backup of anything; device-to-device transfer allowed.
        API 31+: data_extraction_rules excludes cloud backup and leaves device transfer on.
        API 26-30: those rules are not supported, so allow_backup is false there (no backup at all),
        which is why no fullBackupContent file is needed (lint DataExtractionRules does not see that).
    -->
    <application
        android:name=".SingletrailApp"
        tools:ignore="DataExtractionRules"
        android:allowBackup="@bool/allow_backup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Singletrail">

        <!-- singleTask: a file opened from another app lands in Singletrail's own task, not the sender's. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for GPX files and Singletrail zips (spec §8.4, §8.5). Content URIs only (S5). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Some providers call .gpx files octet-stream: accept those only when the path ends in .gpx.
                 Android's pathPattern stops ".*" at the first dot, hence one pattern per dot count. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.GPX" />
                <data android:pathPattern=".*\\..*\\.GPX" />
            </intent-filter>

            <!-- Share sheet. The content is parsed and rejected unless it is safe, valid GPX. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- Shared GPX, zips and diagnostics (spec §8.5): read-only grants for cache/share/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The ride (spec §6): started only from the visible app; not exported. -->
        <service
            android:name=".ride.RideService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
