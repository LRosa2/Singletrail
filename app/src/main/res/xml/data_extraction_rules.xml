<?xml version="1.0" encoding="utf-8"?>
<!--
    Spec D21 / S1: routes, stars and ride history (location tracks) never go to cloud backup.
    Device-to-device transfer keeps its default (everything), so a new phone set up from the old
    one gets the library directly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
